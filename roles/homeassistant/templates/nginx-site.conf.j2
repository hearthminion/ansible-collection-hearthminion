# Ansible managed

server {
  listen 80 {% if homeassistant_nginx_default_server %}default_server{% endif %};
  listen [::]:80 {% if homeassistant_nginx_default_server %}default_server{% endif %};
  server_name {{ inventory_hostname }} {{ inventory_hostname_short }};
  return 301 https://{{ inventory_hostname }}$request_uri;
}

server {
  listen 443 ssl {% if homeassistant_nginx_default_server %}default_server{% endif %};
  listen [::]:443 ssl {% if homeassistant_nginx_default_server %}default_server{% endif %};

  include snippets/{{ inventory_hostname }}.conf;

  root /var/www/html;

  server_name {{ inventory_hostname }} {{ inventory_hostname_short }};

  location / {
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_pass http://localhost:{{ hearthminion_homeassistant_port }};
  }
}
